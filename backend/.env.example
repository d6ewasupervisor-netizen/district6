# Postgres connection string (Railway provides this automatically when you attach a Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 32+ byte random string used to sign tokenized links. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-32-byte-random

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sending identity in Resend
EMAIL_FROM=District 6 Compliance <noreply@retail-odyssey.com>

# Supervisor mailbox that receives every signed receipt
EMAIL_TO=april.gauthier@retailodyssey.com

# Public base URL where the static frontend is hosted (no trailing slash)
FRONTEND_BASE_URL=https://district6-compliance.github.io

# How long a tokenized link is valid before it expires
LINK_TTL_DAYS=30

# Port the Express server listens on (Railway sets PORT automatically; this is for local dev)
PORT=3000
