{
  "pageKey": "home",
  "html": "<main class=\"container\">\r\n    <div class=\"brand\">\r\n      <img src=\"assets/logo.png\" alt=\"Retail Odyssey\" />\r\n    </div>\r\n\r\n    <h1>District 6 Compliance Hub</h1>\r\n    <p class=\"lead\">Enter your email to receive your secure acknowledgement link.</p>\r\n\r\n    <section class=\"card\" aria-labelledby=\"form-heading\">\r\n      <h2 id=\"form-heading\">Request your link</h2>\r\n\r\n      <div id=\"status\" class=\"notice hidden\" role=\"status\" aria-live=\"polite\"></div>\r\n\r\n      <label for=\"email\">Work email</label>\r\n      <input id=\"email\" type=\"email\" autocomplete=\"email\" inputmode=\"email\" placeholder=\"your.email@example.com\" autocapitalize=\"none\" spellcheck=\"false\" />\r\n      <p class=\"help-text\">Enter the email address your supervisor has on file.</p>\r\n\r\n      <button id=\"send-btn\" class=\"primary\" type=\"button\">Send my link</button>\r\n      <button id=\"sms-send-btn\" class=\"secondary\" type=\"button\">Text me a code</button>\r\n\r\n      <div id=\"sms-step\" class=\"hidden\">\r\n        <p class=\"help-text\" style=\"margin-bottom: 8px;\">Code texted to <span id=\"sms-masked\">—</span></p>\r\n        <label for=\"sms-code\">Code</label>\r\n        <input id=\"sms-code\" type=\"text\" autocomplete=\"one-time-code\" inputmode=\"numeric\" maxlength=\"6\" placeholder=\"123456\" spellcheck=\"false\" />\r\n        <button id=\"sms-submit-btn\" class=\"primary\" type=\"button\">Submit code</button>\r\n      </div>\r\n    </section>\r\n\r\n    <p class=\"lead\" style=\"margin-top: 24px; font-size: 14px;\">\r\n      If you have questions, contact your District 6 Supervisor.\r\n    </p>\r\n\r\n    <footer>\r\n      District 6 Compliance Hub &middot; Spring 2026 Edition\r\n    </footer>\r\n  </main>\r\n\r\n  <!-- ── Access-request overlay ────────────────────────────────────────────── -->\r\n  <div id=\"access-overlay\" class=\"access-overlay hidden\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"overlay-heading\">\r\n    <div id=\"overlay-backdrop\" class=\"access-overlay-backdrop\"></div>\r\n    <div class=\"access-overlay-panel\" role=\"document\">\r\n\r\n      <!-- Icon -->\r\n      <div class=\"access-overlay-icon-wrap\">\r\n        <div class=\"access-overlay-icon-bg\">\r\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\r\n            <rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"></rect>\r\n            <path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path>\r\n          </svg>\r\n        </div>\r\n      </div>\r\n\r\n      <h2 id=\"overlay-heading\">You're not on the access list yet</h2>\r\n      <p class=\"access-overlay-lead\">No worries — fill in your details below and a District 6 manager will review your request. Once approved, you'll receive a sign-in link right away at the email address you provide.</p>\r\n\r\n      <!-- Status banner (errors + success) -->\r\n      <div id=\"overlay-status\" class=\"notice hidden\" role=\"status\" aria-live=\"polite\"></div>\r\n\r\n      <!-- Form -->\r\n      <div id=\"overlay-form\">\r\n        <label for=\"overlay-name\">Your full name</label>\r\n        <input id=\"overlay-name\" type=\"text\" autocomplete=\"name\" placeholder=\"Jane Smith\" />\r\n\r\n        <label for=\"overlay-email\" style=\"margin-top: 14px;\">Email address</label>\r\n        <input id=\"overlay-email\" type=\"email\" autocomplete=\"email\" inputmode=\"email\" autocapitalize=\"none\" spellcheck=\"false\" placeholder=\"your.email@example.com\" />\r\n\r\n        <label for=\"overlay-reason\" style=\"margin-top: 14px;\">\r\n          Supervisor / reason\r\n          <span style=\"font-weight: 400; color: var(--text-muted);\">(optional)</span>\r\n        </label>\r\n        <input id=\"overlay-reason\" type=\"text\" placeholder=\"e.g. District 6, sent by April Gauthier\" />\r\n\r\n        <button id=\"overlay-submit\" class=\"primary\" type=\"button\">Request access</button>\r\n\r\n        <button id=\"overlay-cancel\" class=\"access-overlay-cancel\" type=\"button\">\r\n          Cancel — try a different email\r\n        </button>\r\n      </div>\r\n\r\n      <!-- Success state (replaces form) -->\r\n      <div id=\"overlay-success\" class=\"access-overlay-success hidden\">\r\n        <div class=\"access-overlay-success-icon\">\r\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\r\n            <polyline points=\"20 6 9 17 4 12\"></polyline>\r\n          </svg>\r\n        </div>\r\n        <h2 style=\"color: var(--success);\">Request sent!</h2>\r\n        <p>A manager will review your request and you'll receive an email with a sign-in link once approved.</p>\r\n        <button id=\"overlay-close-success\" class=\"secondary\" type=\"button\" style=\"margin-top: 16px; width: 100%;\">Close</button>\r\n      </div>\r\n\r\n    </div>\r\n  </div>\r\n  <!-- ── End overlay ───────────────────────────────────────────────────────── -->",
