  "html": "<main class=\"container\">\r\n    <div class=\"brand\">\r\n      <img src=\"assets/logo.png\" alt=\"Retail Odyssey\" />\r\n    </div>\r\n\r\n    <h1>Policy Acknowledgement</h1>\r\n    <p class=\"lead\">Spring 2026 Edition · Effective May 1, 2026</p>\r\n\r\n    <div id=\"verify-status\" class=\"notice hidden\" role=\"status\" aria-live=\"polite\"></div>\r\n\r\n    <div id=\"hub\" class=\"hidden\">\r\n      <p class=\"lead\">\r\n        Signing as <span id=\"signer-email\" class=\"signer-email\">—</span>\r\n      </p>\r\n\r\n      <section class=\"card\">\r\n        <h2>Step 1 — Review the three policies</h2>\r\n        <p class=\"help-text\">\r\n          Open each document and scroll all the way to the end. The\r\n          acknowledgement checkbox unlocks once you reach the bottom of the\r\n          document.\r\n        </p>\r\n\r\n        <div class=\"doc-list\">\r\n          <div class=\"doc-card\" data-doc=\"attendance\">\r\n            <h3 class=\"doc-card-title\">Attendance &amp; Timekeeping</h3>\r\n            <p class=\"doc-meta\">Policy · PDF</p>\r\n            <div class=\"doc-card-row\">\r\n              <button class=\"secondary doc-open\" type=\"button\" data-pdf-src=\"docs/attendance.pdf\" data-pdf-title=\"Attendance &amp; Timekeeping\">Open</button>\r\n              <div class=\"doc-card-status\" data-timer></div>\r\n            </div>\r\n            <label class=\"checkbox-row disabled\">\r\n              <input type=\"checkbox\" class=\"doc-check\" disabled />\r\n              <span>I have read this document</span>\r\n            </label>\r\n          </div>\r\n\r\n          <div class=\"doc-card\" data-doc=\"dressCode\">\r\n            <h3 class=\"doc-card-title\">Dress Code</h3>\r\n            <p class=\"doc-meta\">Policy · PDF</p>\r\n            <div class=\"doc-card-row\">\r\n              <button class=\"secondary doc-open\" type=\"button\" data-pdf-src=\"docs/dress-code.pdf\" data-pdf-title=\"Dress Code\">Open</button>\r\n              <div class=\"doc-card-status\" data-timer></div>\r\n            </div>\r\n            <label class=\"checkbox-row disabled\">\r\n              <input type=\"checkbox\" class=\"doc-check\" disabled />\r\n              <span>I have read this document</span>\r\n            </label>\r\n          </div>\r\n\r\n          <div class=\"doc-card\" data-doc=\"sop\">\r\n            <h3 class=\"doc-card-title\">Standard Operating Procedures</h3>\r\n            <p class=\"doc-meta\">SOP · PDF</p>\r\n            <div class=\"doc-card-row\">\r\n              <button class=\"secondary doc-open\" type=\"button\" data-pdf-src=\"docs/sop.pdf\" data-pdf-title=\"Standard Operating Procedures\">Open</button>\r\n              <div class=\"doc-card-status\" data-timer></div>\r\n            </div>\r\n            <label class=\"checkbox-row disabled\">\r\n              <input type=\"checkbox\" class=\"doc-check\" disabled />\r\n              <span>I have read this document</span>\r\n            </label>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"card\">\r\n        <h2>Reference materials</h2>\r\n        <p class=\"help-text\">\r\n          These resources are provided for your reference. You don't need to\r\n          open them to complete your acknowledgement, but please keep them\r\n          handy — they cover the broader expectations and partner policies\r\n          you'll encounter every day in District 6.\r\n        </p>\r\n\r\n        <div class=\"ref-list\">\r\n          <a class=\"ref-card\" href=\"docs/handbook.pdf\" data-ref-pdf data-pdf-src=\"docs/handbook.pdf\" data-pdf-title=\"Teammate Handbook\" target=\"_blank\" rel=\"noopener\">\r\n            <div class=\"ref-card-body\">\r\n              <h3 class=\"ref-card-title\">Teammate Handbook</h3>\r\n              <p class=\"ref-card-desc\">\r\n                Your full guide to working at Retail Odyssey: pay, time off,\r\n                conduct expectations, benefits, safety, and the day-to-day\r\n                policies that apply to every teammate.\r\n              </p>\r\n              <span class=\"ref-card-meta\">Reference · PDF</span>\r\n            </div>\r\n            <span class=\"ref-card-action\" aria-hidden=\"true\">Open</span>\r\n          </a>\r\n\r\n          <a class=\"ref-card\" href=\"docs/kompass.pdf\" data-ref-pdf data-pdf-src=\"docs/kompass.pdf\" data-pdf-title=\"Kompass Responsibilities\" target=\"_blank\" rel=\"noopener\">\r\n            <div class=\"ref-card-body\">\r\n              <h3 class=\"ref-card-title\">Kompass Responsibilities</h3>\r\n              <p class=\"ref-card-desc\">\r\n                What's expected of you in Kompass — clock-in/out, task\r\n                completion, photo documentation, and how your work shows up\r\n                to your Supervisor and the client.\r\n              </p>\r\n              <span class=\"ref-card-meta\">Reference · PDF</span>\r\n            </div>\r\n            <span class=\"ref-card-action\" aria-hidden=\"true\">Open</span>\r\n          </a>\r\n\r\n          <a class=\"ref-card\" href=\"docs/vendor.pdf\" data-ref-pdf data-pdf-src=\"docs/vendor.pdf\" data-pdf-title=\"Fred Meyer Vendor Policies\" target=\"_blank\" rel=\"noopener\">\r\n            <div class=\"ref-card-body\">\r\n              <h3 class=\"ref-card-title\">Fred Meyer Vendor Policies</h3>\r\n              <p class=\"ref-card-desc\">\r\n                The store's expectations for vendors and merchandisers while\r\n                you're on the floor — check-in, conduct, dress, breaks, and\r\n                what to do if a store leader has a question for you.\r\n              </p>\r\n              <span class=\"ref-card-meta\">Reference · PDF</span>\r\n            </div>\r\n            <span class=\"ref-card-action\" aria-hidden=\"true\">Open</span>\r\n          </a>\r\n        </div>\r\n      </section>\r\n\r\n      <section id=\"sign-section\" class=\"card hidden\" aria-labelledby=\"sign-heading\">\r\n        <h2 id=\"sign-heading\">Step 2 — Sign your acknowledgement</h2>\r\n\r\n        <div id=\"submit-status\" class=\"notice hidden\" role=\"status\" aria-live=\"polite\"></div>\r\n\r\n        <p>\r\n          <strong>Email:</strong>\r\n          <span id=\"signer-email-2\" class=\"signer-email\">—</span>\r\n        </p>\r\n\r\n        <label for=\"full-name\">Full Name</label>\r\n        <input id=\"full-name\" type=\"text\" autocomplete=\"name\" placeholder=\"First Last\" />\r\n\r\n        <div style=\"margin-top: 16px;\">\r\n          <label>Signature</label>\r\n          <div class=\"sig-wrap\">\r\n            <canvas id=\"signature-pad\"></canvas>\r\n          </div>\r\n          <div class=\"sig-actions\">\r\n            <span>Sign with your finger or mouse.</span>\r\n            <button id=\"clear-sig\" type=\"button\">Clear</button>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"legal-text\">\r\n          By signing below, I acknowledge that I have received, reviewed, and understand the\r\n          District 6 Attendance &amp; Timekeeping Policy, Dress Code Policy, and Standard\r\n          Operating Procedures (Spring 2026 Edition, effective May 1, 2026). I agree to\r\n          follow the rules and guidelines stated in these documents and understand that\r\n          violations may result in disciplinary action up to and including termination. I\r\n          confirm I know how to access these policies in the future and may request\r\n          additional copies from my Supervisor at any time.\r\n        </div>\r\n\r\n        <label class=\"checkbox-row\">\r\n          <input id=\"agree-check\" type=\"checkbox\" />\r\n          <span>I have read and agree to the acknowledgement statement above.</span>\r\n        </label>\r\n\r\n        <button id=\"submit-btn\" class=\"primary\" type=\"button\" disabled>Submit Acknowledgement</button>\r\n      </section>\r\n    </div>\r\n\r\n    <footer>\r\n      District 6 Compliance Hub &middot; Spring 2026 Edition\r\n    </footer>\r\n  </main>",
